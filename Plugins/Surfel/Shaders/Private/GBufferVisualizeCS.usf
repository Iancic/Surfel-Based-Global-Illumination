#include "/Engine/Public/Platform.ush"
#include "/Engine/Private/Common.ush"
#include "/Engine/Private/ScreenPass.ush"
#include "/Engine/Private/DeferredShadingCommon.ush"

// In sync with EGBufferVisualizeMode in C++.
#define VIS_MODE_SCENECOLOR   0
#define VIS_MODE_BASECOLOR    1
#define VIS_MODE_WORLDNORMAL  2
#define VIS_MODE_METALLIC     3
#define VIS_MODE_ROUGHNESS    4
#define VIS_MODE_SPECULAR     5
#define VIS_MODE_DEPTH        6
#define VIS_MODE_SHADINGMODEL 7

Texture2D InputSceneColor;

// NOTE: the G-Buffer textures are NOT declared here.
// DeferredShadingCommon.ush already declares them (under #if SHADING_PATH_DEFERRED,
// in a block commented "Matches FSceneTextureParameters"):
// Those names match our C++ parameter struct exactly, so binding still works.
// Re-declaring them here is a "redefinition of 'GBufferATexture'" compile error.

SCREEN_PASS_TEXTURE_VIEWPORT(InputViewport)

int VisualizeMode;
float DepthScale;

RWTexture2D<float4> OutRenderTarget;

// Map different shading models to colors.
float3 ShadingModelToColor(uint Id)
{
    switch (Id)
    {
        case SHADINGMODELID_UNLIT:              return float3(0.10, 0.10, 0.10);
        case SHADINGMODELID_DEFAULT_LIT:        return float3(0.20, 0.60, 1.00);
        case SHADINGMODELID_SUBSURFACE:         return float3(1.00, 0.40, 0.40);
        case SHADINGMODELID_PREINTEGRATED_SKIN: return float3(1.00, 0.70, 0.55);
        case SHADINGMODELID_CLEAR_COAT:         return float3(0.90, 0.90, 0.30);
        case SHADINGMODELID_SUBSURFACE_PROFILE: return float3(1.00, 0.30, 0.75);
        case SHADINGMODELID_TWOSIDED_FOLIAGE:   return float3(0.30, 0.90, 0.30);
        case SHADINGMODELID_HAIR:               return float3(0.60, 0.30, 0.10);
        case SHADINGMODELID_CLOTH:              return float3(0.50, 0.50, 0.90);
        case SHADINGMODELID_EYE:                return float3(0.95, 0.95, 0.95);
        default:                                return float3(0.00, 0.00, 0.00);
    }
}

[numthreads(THREADS_X, THREADS_Y, THREADS_Z)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
    if (any(DispatchThreadId.xy >= (uint2)InputViewport_ViewportMax))
    {
        return;
    }

    uint2 PixelPos = DispatchThreadId.xy;

    float2 UV = ((float2(DispatchThreadId.xy) + 0.5f))
              * InputViewport_ExtentInverse;

    float4 SceneColor = InputSceneColor.SampleLevel(GlobalPointClampedSampler, UV, 0);

    // Point-sample the G-Buffer. Load() with integer coords avoids any filtering,
    // which matters because this data is not colour and must not be blended.
    //
    // NOTE: this indexes the G-Buffer with the OUTPUT pixel coordinate. That is only
    // correct while the two textures are the same size, i.e. at 100% screen percentage
    // with no temporal upscaling. See KNOWN-ISSUES.md.
    int3 LoadPos = int3(PixelPos, 0);

    float4 GBufferA = GBufferATexture.Load(LoadPos);
    float4 GBufferB = GBufferBTexture.Load(LoadPos);
    float4 GBufferC = GBufferCTexture.Load(LoadPos);
    float4 GBufferD = GBufferDTexture.Load(LoadPos);
    float4 GBufferE = GBufferETexture.Load(LoadPos);
    float4 GBufferF = GBufferFTexture.Load(LoadPos);

    float DeviceZ    = SceneDepthTexture.Load(LoadPos).r;
    float SceneDepth = ConvertFromDeviceZ(DeviceZ);

    // Unpack the raw targets into the engine's structured form.
    FGBufferData GBuffer = DecodeGBufferData(
        GBufferA, GBufferB, GBufferC, GBufferD, GBufferE, GBufferF,
        (float4)0,
        0.0f,
        0u,
        SceneDepth,
        true,
        false);

    float3 Result;

    switch (VisualizeMode)
    {
        case VIS_MODE_BASECOLOR:
            Result = GBuffer.BaseColor;
            break;

        case VIS_MODE_WORLDNORMAL:
            Result = GBuffer.WorldNormal * 0.5f + 0.5f;
            break;

        case VIS_MODE_METALLIC:
            Result = GBuffer.Metallic.xxx;
            break;

        case VIS_MODE_ROUGHNESS:
            Result = GBuffer.Roughness.xxx;
            break;

        case VIS_MODE_SPECULAR:
            Result = GBuffer.Specular.xxx;
            break;

        case VIS_MODE_DEPTH:
            Result = saturate(SceneDepth / max(DepthScale, 1.0f)).xxx;
            break;

        case VIS_MODE_SHADINGMODEL:
            Result = ShadingModelToColor(GBuffer.ShadingModelID);
            break;

        default:
            Result = SceneColor.rgb;
            break;
    }

    OutRenderTarget[PixelPos] = float4(Result, SceneColor.a);
}