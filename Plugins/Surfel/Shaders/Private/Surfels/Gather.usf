#include "/Engine/Public/Platform.ush"
#include "/Engine/Private/Common.ush"
#include "/Engine/Private/DeferredShadingCommon.ush"

Texture2D CoverageTexture;
float SpawnChance;
float SpawnCoverageThreshold;

RWStructuredBuffer<uint> SurfelCount;
RWStructuredBuffer<float4> SurfelPositionAndRadius;
RWStructuredBuffer<float4> SurfelNormalAndFlags;

uint SurfelBudget;
float SurfelRadius;

uint2 ViewRectMin;
uint2 ViewRectMax;

#define GROUP_SIZE (16 * 16 * 1) // in Gather.hpp

groupshared float SharedCoverage[GROUP_SIZE];
groupshared uint SharedWinnerIndex[GROUP_SIZE];

float PixelNoise(float2 Pixel)
{
    return frac(52.9829189f * frac(dot(Pixel, float2(0.06711056f, 0.00583715f))));
}

[numthreads(THREADS_X, THREADS_Y, THREADS_Z)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID, uint GroupIndex : SV_GroupIndex)
{
    // Step 1: Decide based on coverage whether to spawn
    
    float CoverageValue = 1e9f;
    float DepthZ = 0.f;
    int3 LoadPos = int3(0, 0, 0);
    
    // Dispatch shader per screen tiles
    uint2 PixelPos = ViewRectMin + DispatchThreadId.xy;
    
    bool bInBounds = all(PixelPos < ViewRectMax);
    if (bInBounds)
    {
        LoadPos = int3(PixelPos, 0);
        float SampledCoverage = CoverageTexture.Load(LoadPos);
        DepthZ = SceneTexturesStruct.SceneDepthTexture.Load(LoadPos).r;

        // Only a spawn candidate if not covered and not sky
        if (SampledCoverage < SpawnCoverageThreshold && DepthZ > 0.0f)
        {
            // Pixels with equal coverage are treated differently
            // Breaks uniformity
            uint3 Hash = Rand3DPCG16(int3(PixelPos, View.StateFrameIndex));
            // 65535 max 16 bit value, jitter is gonna be float form 0 to 1
            float Jitter = Hash.x / 65535.0f;

            CoverageValue = SampledCoverage + Jitter * 0.001f;
        }
    }
    
    SharedCoverage[GroupIndex] = CoverageValue;
    SharedWinnerIndex[GroupIndex] = GroupIndex;
    GroupMemoryBarrierWithGroupSync();

    // Parallel min-reduction across the tile: halve the active range each pass.
    [unroll]
    for (uint Stride = GROUP_SIZE / 2; Stride > 0; Stride >>= 1)
    {
        if (GroupIndex < Stride)
        {
            uint OtherIndex = GroupIndex + Stride;
            if (SharedCoverage[OtherIndex] < SharedCoverage[GroupIndex])
            {
                SharedCoverage[GroupIndex] = SharedCoverage[OtherIndex];
                SharedWinnerIndex[GroupIndex] = SharedWinnerIndex[OtherIndex];
            }
        }
        GroupMemoryBarrierWithGroupSync();
    }

    // Only the thread holding the tile's least-covered pixel may spawn.
    bool bIsWinner = (GroupIndex == SharedWinnerIndex[0]) && (SharedCoverage[0] < 1e9f);
    if (!bIsWinner) return;
        
    // Don't spawn suitable candidates for every empty cell
    // I add a random factor so some cells get skipped for but get spawned later
    // Best example is the first frame where I could spawn the whole budget on the top part of the screen 
    // Without it reaching lower
    uint3 Hash = Rand3DPCG16(int3(PixelPos, View.StateFrameIndex));
    float Random01 = Hash.x / 65535.0f;
    if (Random01 >= SpawnChance)
    {
        return;
    }
    
    // Step 2: Recycle
    
    // Step 3: Spawning Surfels Below
    
    // Get normal at this pixel
    float4 GBufferA = SceneTexturesStruct.GBufferATexture.Load(LoadPos);
    float3 WorldNormal = normalize(GBufferA.xyz * 2.0f - 1.0f);
    
    // Surfels should keep their world position across frames
    // PrimaryView.PreViewTranslation changes with camera
    float4 SvPosition = float4(PixelPos + 0.5f, DepthZ, 1.0f);
    float3 TranslatedWorldPosition = SvPositionToTranslatedWorld(SvPosition);
    float3 WorldPosition = DFSubtractDemote(TranslatedWorldPosition, PrimaryView.PreViewTranslation);

    // Surfel Index
    uint SurfelIndex;
    InterlockedAdd(SurfelCount[0], 1, SurfelIndex);
    if (SurfelIndex >= SurfelBudget)
    {
        InterlockedAdd(SurfelCount[0], -1);
        return;
    }
    
    // World space width of one pixel at this depth (cm per pixel)
    // SurfelRadius is now in pixels, e.g. 8 to 32
    float LinearDepth = ConvertFromDeviceZ(DepthZ);
    float PixelWorldSize = 2.0f * LinearDepth / (View.ViewToClip[0][0] * View.ViewSizeAndInvSize.x);
    
    float Radius = SurfelRadius * PixelWorldSize;
    if (Radius < SurfelRadius) Radius = SurfelRadius;
    
    SurfelPositionAndRadius[SurfelIndex] = float4(WorldPosition, Radius);
    SurfelNormalAndFlags[SurfelIndex] = float4(WorldNormal, 0.0f);
}