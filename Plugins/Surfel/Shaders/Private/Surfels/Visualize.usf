#include "/Engine/Public/Platform.ush"
#include "/Engine/Private/Common.ush"
#include "/Engine/Private/ScreenPass.ush"
#include "/Engine/Private/DeferredShadingCommon.ush"
#include "/Surfel/Surfels/SurfelCommon.ush"

Texture2D InputSceneColor;

SCREEN_PASS_TEXTURE_VIEWPORT(InputViewport)

float Intensity;

RWTexture2D<float4> OutRenderTarget;

RWStructuredBuffer<uint> SurfelCount;
RWStructuredBuffer<float4> SurfelPositionAndRadius;
RWStructuredBuffer<float4> SurfelNormalAndFlags;

RWStructuredBuffer<uint> GridCellEntries;
RWStructuredBuffer<uint> GridCounter;
float3 GridPosition;
uint GridCellCount;
uint CellResolution;
uint CellCapacity;
uint CellSize;

uint bUseGrid;
float SpawnCoverageThreshold;

Texture2D CoverageTexture;
uint bHasCoverageTexture;
float CoverageScale;

Texture2D IrradianceTexture;
uint bHasIrradianceTexture;
float GIIntensity;
Texture2D AmbientOcclusionTexture;

uint VisualizeMode;
uint GridVisFlags;
float GridVisEdgeThickness;

// Generated with Claude
float3 HashColor(uint Seed)
{
    float S = (float)Seed;
    float3 Color = frac(sin(float3(S * 12.9898f, S * 78.233f, S * 39.425f)) * 43758.5453f);
    return saturate(Color * 0.7f + 0.3f);
}

// Black -> blue -> green -> red -> white, so both ends of the range stay readable.
float3 HeatColor(float T)
{
    T = saturate(T);
    float3 Color = lerp(float3(0.0f, 0.0f, 0.3f), float3(0.0f, 1.0f, 0.0f), saturate(T * 2.0f));
    Color = lerp(Color, float3(1.0f, 0.0f, 0.0f), saturate(T * 2.0f - 1.0f));
    return lerp(Color, float3(1.0f, 1.0f, 1.0f), saturate(T * 4.0f - 3.0f));
}

// Index of the grid cell a world position falls in, or false when it is outside the grid.
bool GetGridCell(float3 WorldPosition, out int3 CellCoord, out uint CellIdx)
{
    CellCoord = int3(floor((WorldPosition - GridPosition) / (float)CellSize));
    CellIdx = 0;

    if (any(CellCoord < 0) || any(CellCoord >= (int)CellResolution))
    {
        return false;
    }

    CellIdx = (uint)CellCoord.x
        + (uint)CellCoord.y * CellResolution
        + (uint)CellCoord.z * CellResolution * CellResolution;
    return true;
}

struct FSurfelHit
{
    uint Index;
    float Weight;
};

void TestSurfel(uint SurfelIndex, float3 PixelWorldPosition, float3 PixelNormal, inout FSurfelHit Hit)
{
    float Weight = SurfelCoverageWeight(PixelWorldPosition, PixelNormal,
        SurfelPositionAndRadius[SurfelIndex], SurfelNormalAndFlags[SurfelIndex].xyz);

    // Drawn only where this surfel alone stops Gather from spawning
    if (Weight <= 0.0f || Weight < SpawnCoverageThreshold)
    {
        return;
    }

    bool bStronger = Weight > Hit.Weight;
    bool bTieWon = Weight == Hit.Weight && SurfelIndex < Hit.Index;
    if (bStronger || bTieWon)
    {
        Hit.Index = SurfelIndex;
        Hit.Weight = Weight;
    }
}

float3 VisualizeSurfels(float3 SceneColor, float3 PixelWorldPosition, float3 PixelNormal)
{
    FSurfelHit Hit;
    Hit.Index = 0xFFFFFFFF;
    Hit.Weight = 0.0f;

    if (bUseGrid != 0)
    {
        // Outside the grid Scatter sees no surfels either, so draw none
        int3 PixelCell;
        uint CellIdx;
        if (!GetGridCell(PixelWorldPosition, PixelCell, CellIdx))
        {
            return SceneColor;
        }

        uint EntryCount = min(GridCounter[CellIdx], CellCapacity);
        for (uint i = 0; i < EntryCount; i++)
        {
            TestSurfel(GridCellEntries[CellIdx * CellCapacity + i], PixelWorldPosition, PixelNormal, Hit);
        }
    }
    else
    {
        uint NumSurfels = SurfelCount[0];
        for (uint SurfelIndex = 0; SurfelIndex < NumSurfels; SurfelIndex++)
        {
            TestSurfel(SurfelIndex, PixelWorldPosition, PixelNormal, Hit);
        }
    }

    if (Hit.Index == 0xFFFFFFFF)
    {
        return SceneColor;
    }

    // Blend between random color, scene color and an intensity value
    return lerp(SceneColor, HashColor(Hit.Index), saturate(Intensity));
}

float3 VisualizeGrid(float3 SceneColor, float3 PixelWorldPosition)
{
    int3 PixelCell;
    uint CellIdx;
    if (!GetGridCell(PixelWorldPosition, PixelCell, CellIdx))
    {
        return SceneColor; // Outside the grid: nothing is binned here
    }

    uint EntryCount = GridCounter[CellIdx];
    float Fullness = saturate((float)EntryCount / (float)CellCapacity);

    // Wireframe: how far into the cell this pixel is, on each axis.
    float3 CellLocal = frac((PixelWorldPosition - GridPosition) / (float)CellSize);
    float3 EdgeDistance = min(CellLocal, 1.0f - CellLocal);
    bool bOnEdge = (GridVisFlags & GRID_VIS_WIREFRAME) != 0
        && min(EdgeDistance.x, min(EdgeDistance.y, EdgeDistance.z)) < GridVisEdgeThickness;

    // Empty cells can be hidden, but keep their wireframe so the grid's extent stays visible.
    if (EntryCount == 0 && (GridVisFlags & GRID_VIS_HIDE_EMPTY) != 0 && !bOnEdge)
    {
        return SceneColor;
    }

    float3 CellColor = (GridVisFlags & GRID_VIS_HEATMAP) != 0
        ? HeatColor(Fullness)
        // Empty cells stay dark so the populated part of the grid stands out.
        : HashColor(CellIdx) * lerp(0.15f, 1.0f, Fullness);

    // More surfels wanted in than the cell can hold, so the grid query is dropping some.
    if (EntryCount > CellCapacity && (GridVisFlags & GRID_VIS_OVERFLOW) != 0)
    {
        CellColor = float3(1.0f, 0.0f, 0.0f);
    }

    if (bOnEdge)
    {
        CellColor = float3(1.0f, 1.0f, 1.0f);
    }

    return lerp(SceneColor, CellColor, saturate(Intensity));
}

float3 VisualizeCoverage(float3 SceneColor, int3 LoadPos)
{
    if (bHasCoverageTexture == 0)
    {
        return SceneColor; // Nothing ran this frame, so there is no map to show
    }

    float Coverage = CoverageTexture.Load(LoadPos).r;
    if (Coverage >= SURFEL_COVERAGE_OUT_OF_GRID)
    {
        return SceneColor * 0.15f; // Outside the grid: no coverage was computed, spawning is blocked
    }
    return HeatColor(Coverage / max(CoverageScale, 0.0001f));
}

float3 VisualizeIrradiance(float3 SceneColor, int3 LoadPos)
{
    if (bHasIrradianceTexture == 0)
    {
        return SceneColor;
    }

    float4 Irradiance = IrradianceTexture.Load(LoadPos);

    // GBufferC holds base color in the default deferred layout
    float3 BaseColor = SceneTexturesStruct.GBufferCTexture.Load(LoadPos).rgb;
    // This in place of composite

    return Irradiance.rgb / PI * Intensity;
}

// Only the surfel bounce light, computed exactly like Composite.usf adds it to scene color
float3 VisualizeIndirect(float3 SceneColor, int3 LoadPos)
{
    if (bHasIrradianceTexture == 0)
    {
        return SceneColor;
    }

    FGBufferData GBuffer = GetGBufferDataUint(LoadPos.xy);
    if (GBuffer.ShadingModelID == SHADINGMODELID_UNLIT)
    {
        return 0;
    }

    float4 IrradianceAndWeight = IrradianceTexture.Load(LoadPos);
    float3 Indirect = SurfelIndirectRadiance(IrradianceAndWeight, GBuffer.DiffuseColor);
    Indirect *= AmbientOcclusionTexture.Load(LoadPos).r;

    // Post-process scene color is still pre-exposed linear HDR, so this lines up with the composited image
    return Indirect * View.PreExposure * GIIntensity;
}

// The ambient occlusion buffer on its own, white = open, black = fully occluded
float3 VisualizeSSAO(float3 SceneColor, int3 LoadPos)
{
    float AmbientOcclusion = AmbientOcclusionTexture.Load(LoadPos).r;
    return AmbientOcclusion.xxx;
}

[numthreads(THREADS_X, THREADS_Y, THREADS_Z)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
    if (any(DispatchThreadId.xy >= (uint2)InputViewport_ViewportMax))
    {
        return;
    }

    // Pixel coordinate inside the full texture (viewport may be offset in it).
    uint2 PixelPos = (uint2)InputViewport_ViewportMin + DispatchThreadId.xy;

    // UV in [0,1] across the texture, sampled at the pixel centre (+0.5).
    float2 UV = (float2(InputViewport_ViewportMin) + (float2(DispatchThreadId.xy) + 0.5f))
              * InputViewport_ExtentInverse;

    float4 SceneColor = InputSceneColor.SampleLevel(GlobalPointClampedSampler, UV, 0);
    
    float2 ViewportUV = (float2(PixelPos - (uint2)InputViewport_ViewportMin) + 0.5f) * InputViewport_ViewportSizeInverse;
    float2 RenderPixelPos = View.ViewRectMin.xy + ViewportUV * View.ViewSizeAndInvSize.xy;

    int3 LoadPos = int3(RenderPixelPos, 0);
    float DeviceZ = SceneTexturesStruct.SceneDepthTexture.Load(LoadPos).r;

    // Sky
    if (DeviceZ <= 0.0f)
    {
        OutRenderTarget[PixelPos] = SceneColor;
        return;
    }

    // Reconstruct this pixel's true world position (same space surfels are stored in)
    float4 SvPosition = float4(RenderPixelPos, DeviceZ, 1.0f);
    float3 TranslatedWorldPosition = SvPositionToTranslatedWorld(SvPosition);
    float3 PixelWorldPosition = DFFastSubtractDemote(TranslatedWorldPosition, PrimaryView.PreViewTranslation);
    float3 PixelNormal = normalize(SceneTexturesStruct.GBufferATexture.Load(LoadPos).xyz * 2.0f - 1.0f);

    float3 Result = SceneColor.rgb;

    if (VisualizeMode == VISUALIZE_MODE_SURFELS)
    {
        Result = VisualizeSurfels(SceneColor.rgb, PixelWorldPosition, PixelNormal);
    }
    else if (VisualizeMode == VISUALIZE_MODE_GRID)
    {
        Result = VisualizeGrid(SceneColor.rgb, PixelWorldPosition);
    }
    else if (VisualizeMode == VISUALIZE_MODE_COVERAGE)
    {
        Result = VisualizeCoverage(SceneColor.rgb, LoadPos);
    }
    else if (VisualizeMode == VISUALIZE_MODE_IRRADIANCE)
    {
        Result = VisualizeIrradiance(SceneColor.rgb, LoadPos);
    }
    else if (VisualizeMode == VISUALIZE_MODE_INDIRECT)
    {
        Result = VisualizeIndirect(SceneColor.rgb, LoadPos);
    }
    else if (VisualizeMode == VISUALIZE_MODE_SSAO)
    {
        Result = VisualizeSSAO(SceneColor.rgb, LoadPos);
    }
    // Every other mode leaves scene color alone: the lighting-reference modes only
    // reconfigure the renderer from the game thread, there is nothing to draw here.

    OutRenderTarget[PixelPos] = float4(Result, SceneColor.a);
}
