//MegaLightsRayTracing.usf:4
//LumenSoftwareRayTracing.ush:8 set it
#define DISTANCE_FIELD_IN_VIEW_UB 1

#include "/Engine/Private/Common.ush"
#include "/Engine/Private/Random.ush"
#include "/Engine/Private/DistanceField/GlobalDistanceFieldShared.ush"
#include "/Engine/Private/DistanceField/GlobalDistanceFieldUtils.ush"

RWStructuredBuffer<uint> SurfelCount;
RWStructuredBuffer<float4> SurfelPositionAndRadius;
RWStructuredBuffer<float4> SurfelNormalAndFlags;
RWStructuredBuffer<float3> SurfelIrradiance;

uint SurfelBudget;
float SurfelRadius;

uint2 ViewRectMin;
uint2 ViewRectMax;

RWStructuredBuffer<uint> GridCellEntries;
RWStructuredBuffer<uint> GridCounter;

float3 GridPosition;
uint GridCellCount;
uint CellResolution;
uint CellCapacity;
uint CellSize;

// TODO: placeholder, every surfel is treated as a mid-grey diffuse surface.
// Replace with a per-surfel albedo buffer written when the surfel is spawned from the GBuffer.
float3 GetSurfelAlbedo(uint SurfelIndex)
{
	return float3(0.5f, 0.5f, 0.5f);
}

float3 SampleSurfelRadianceAt(float3 WorldPosition, float3 HitNormal)
{
	int3 PixelCell = int3(floor((WorldPosition - GridPosition) / CellSize));
	if (any(PixelCell < 0.) || any(PixelCell >= (float)CellResolution))
	{
		return 0;
	}
	
	uint CellIndex = (uint)PixelCell.x
			+ (uint)PixelCell.y * CellResolution
			+ (uint)PixelCell.z * CellResolution * CellResolution;
	uint Count = min(GridCounter[CellIndex], CellCapacity);

	float3 RadianceSum = 0;
	float WeightSum = 0;

	for (uint i = 0; i < Count; ++i)
	{
		uint Other = GridCellEntries[CellIndex * CellCapacity + i];
		float4 OtherPositionAndRadius = SurfelPositionAndRadius[Other];
		float3 OtherNormal = SurfelNormalAndFlags[Other].xyz;

		float Distance = length(OtherPositionAndRadius.xyz - WorldPosition);
		float Weight = saturate(1.0f - Distance / max(OtherPositionAndRadius.w, 1e-4f)) * saturate(dot(OtherNormal, HitNormal));

		if (Weight > 0.0f)
		{
			float3 Outgoing = GetSurfelAlbedo(Other) / PI * SurfelIrradiance[Other];
			RadianceSum += Outgoing * Weight;
			WeightSum += Weight;
		}
	}

	return WeightSum > 0.0f ? RadianceSum / WeightSum : 0;
}

// Get lights from C++ side and loop through them here

// Unreal probably has something as well like a Hammersley sequence.
// The following 3 functions are taken from: https://www.shadertoy.com/view/ldBcDt
// f and r must be 'out', HLSL passes by value otherwise and the caller never sees the result
void Basis(float3 n, out float3 f, out float3 r)
{
	if(n.z < -0.999999) {
		f = float3(0 , -1, 0);
		r = float3(-1, 0, 0);
	} else {
		float a = 1./(1. + n.z);
		float b = -n.x*n.y*a;
		f = float3(1. - n.x*n.x*a, b, -n.x);
		r = float3(b, 1. - n.y*n.y*a , -n.y);
	}
}

float3 LocalToWorld( float3 localDir, float3 normal ) 
{
	float3 a, b;
	Basis( normal, a, b );
	return localDir.x*a + localDir.y*b + localDir.z*normal;
}

float3 SphericalToCartesian( float rho, float phi, float theta ) 
{
	float sinTheta = sin(theta);
	return float3( sinTheta*cos(phi), sinTheta*sin(phi), cos(theta) )*rho;
}

float3 SampleHemisphereCosWeighted(float3 n, float Xi1, float Xi2 ) 
{
	float theta = acos(sqrt(1.0-Xi1));
	float phi = 2 * PI * Xi2;
	return LocalToWorld( SphericalToCartesian( 1.0, phi, theta ), n );
}

[numthreads(THREADS_X, THREADS_Y, THREADS_Z)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	// One thread per Surfel
	uint SurfelIdx = DispatchThreadId.x;
	if (SurfelIdx >= min(SurfelCount[0], SurfelBudget)) return;
	
	float4 PositionAndRadius = SurfelPositionAndRadius[SurfelIdx];
	float3 Normal = SurfelNormalAndFlags[SurfelIdx].xyz;
	
	float Radius = PositionAndRadius.w;
	float3 Position = PositionAndRadius.xyz;
	
	// Size of one voxel of the finest clipmap
	const float VoxelExtent = GlobalVolumeTranslatedCenterAndExtent[0].w * GlobalVolumeTexelSize;
	
	// Compute direct light on this surfel
	
	
	// Get Ray Direction (random ray on hemisphere weighted by normal)
	uint3 Hash = Rand3DPCG16(int3(SurfelIdx, View.StateFrameIndex, 0));
	
	// Random values are from 0 to 1
	float Random1 = Hash.x / 65535.0f;
	float Random2 = Hash.y / 65535.0f;

	float3 Direction = SampleHemisphereCosWeighted(Normal.xyz, Random1, Random2);

	// The global SDF lives in translated world space (world + PreViewTranslation) to keep float precision
	// near the camera. Surfels are stored in world space, so convert before tracing.
	float3 PreViewTranslation = DFHackToFloat(PrimaryView.PreViewTranslation);
	float3 TranslatedPosition = Position + PreViewTranslation;

	// Offset the origin one voxel along the normal so the ray doesn't immediately hit the surface it starts on
	float3 Origin = TranslatedPosition + Normal * VoxelExtent;

	// TODO: hardcoded trace settings, expose as shader parameters later
	const float MinTraceDistance = 0.0f;
	const float MaxTraceDistance = 10000.0f; // 100m in UE units (cm)
	const float StepFactor = 15.0f;           // 1 = step the full SDF distance each iteration
	const float MinStepFactor = 1.0f;

	// Using Utilities to ray-march until distance is found
	FGlobalSDFTraceInput TraceInput = SetupGlobalSDFTraceInput(Origin, Direction, MinTraceDistance, MaxTraceDistance, StepFactor, MinStepFactor);
	FGlobalSDFTraceResult TraceResult = RayTraceGlobalDistanceField(TraceInput);
	
	uint SDFClimapIndex = TraceResult.HitClipmapIndex;
	
	// At this distance where incoming light is to our surfel
	float3 TotalIncomingRadiance;
	
	// Ray hit 
	if (GlobalSDFTraceResultIsHit(TraceResult))
	{
		// Hit position is in translated world space (same space as the trace origin), which the SDF normal lookup expects
		float3 TranslatedHitPosition = Origin + Direction * TraceResult.HitTime;
		float3 HitNormal = ComputeGlobalDistanceFieldNormal(TranslatedHitPosition, TraceResult.HitClipmapIndex, -Direction);

		// The surfel grid (GridPosition) is in world space, so convert back before looking up surfels
		float3 WorldHitPosition = TranslatedHitPosition - PreViewTranslation;
		TotalIncomingRadiance = SampleSurfelRadianceAt(WorldHitPosition, HitNormal);
	}
	// Ray miss
	else
	{
		TotalIncomingRadiance = 0.f; // Skylight Color
	}
	
	SurfelIrradiance[SurfelIdx] = TotalIncomingRadiance;
}