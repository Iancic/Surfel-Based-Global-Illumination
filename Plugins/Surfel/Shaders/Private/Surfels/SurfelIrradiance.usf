#include "/Engine/Private/Common.ush"
#include "/Engine/Private/Random.ush"

#define DISTANCE_FIELD_IN_VIEW_UB 1
#include "/Engine/Private/DistanceField/GlobalDistanceFieldShared.ush"
#include "/Engine/Private/DistanceField/GlobalDistanceFieldUtils.ush"

#define SUPPORT_CONTACT_SHADOWS 0
#include "/Engine/Private/DeferredLightingCommon.ush"

#include "/Surfel/Surfels/Utilities/SurfelCommon.ush"
#include "/SurfelShared/LightStruct.h"

StructuredBuffer<FSurfelLightStruct> SurfelLights;
uint NumSurfelLights;

RWStructuredBuffer<uint> SurfelCount;
RWStructuredBuffer<float4> SurfelPositionAndRadius;
RWStructuredBuffer<float4> SurfelNormalAndFlags;
RWStructuredBuffer<float4> SurfelIrradiance;
RWStructuredBuffer<float3> SurfelAlbedo;

uint SurfelBudget;
float SurfelRadius;

uint2 ViewRectMin;
uint2 ViewRectMax;

RWStructuredBuffer<uint> GridCellEntries;
RWStructuredBuffer<uint> GridCounter;

float3 GridPosition;
uint GridCellCount;
uint CellResolution;
uint CellCapacity;
uint CellSize;

float MinTraceDistance;
float MaxTraceDistance;
float StepFactor;
float MinStepFactor;
float MaxSamples; 

float3 EvaluateSurfelLight(FSurfelLightStruct Light, float3 TranslatedPos, out float3 L, out float ShadowDistance)
{
	uint Type = (uint)Light.ColorAndType.a;
	if (Type == LIGHT_TYPE_DIRECTIONAL)
	{
		L = Light.DirectionAndInverseFalloff.xyz;
		ShadowDistance = MaxTraceDistance;
		return Light.ColorAndType.rgb;
	}

	float3 ToLight = Light.PositionAndAttenuation.xyz - TranslatedPos;
	float DistSquared = dot(ToLight, ToLight);
	L = ToLight * rsqrt(DistSquared);
	ShadowDistance = sqrt(DistSquared);

	float InverseRadius = Light.PositionAndAttenuation.w;
	float Attenuation;
	
	// Credit: discovered with Claude that lights can have 2 modes to operate on
	//	https://dev.epicgames.com/documentation/unreal-engine/4.1---falloff-exponent?application_version=4.27
	//  https://dev.epicgames.com/documentation/unreal-engine/4.2---inverse-square-falloff?application_version=4.27
	if (Light.DirectionAndInverseFalloff.w == 0) // inverse squared
	{
		Attenuation = 1.0f / (DistSquared + 1.0f);
		Attenuation *= Square(saturate(1.0f - Square(DistSquared * Square(InverseRadius))));
	}
	else
	{
		// Included from deferred path (see include)
		// Most of the light code also inspired from there
		Attenuation = RadialAttenuation(ToLight * InverseRadius, Light.DirectionAndInverseFalloff.w);
	}

	if (Type == LIGHT_TYPE_SPOT)
	{
		Attenuation *= Square(saturate((dot(L, Light.DirectionAndInverseFalloff.xyz) - Light.Angle.x) * Light.Angle.y));
	}
	return Light.ColorAndType.rgb * Attenuation;
}

// Shadow Rays
bool IsLightVisible(float3 TranslatedPos, float3 Normal, float3 L, float ShadowDistance)
{
	const float VoxelExtent = GlobalVolumeTranslatedCenterAndExtent[0].w * GlobalVolumeTexelSize;
	float3 Origin = TranslatedPos + Normal * VoxelExtent;

	FGlobalSDFTraceInput RayMarchInput = SetupGlobalSDFTraceInput(Origin, L, MinTraceDistance, ShadowDistance - VoxelExtent,StepFactor, MinStepFactor);
	return !GlobalSDFTraceResultIsHit(RayTraceGlobalDistanceField(RayMarchInput));
}

float3 ComputeDirectLight(float3 TranslatedPos, float3 Normal)
{
	float3 Irradiance = 0;
	for (uint i = 0; i < NumSurfelLights; ++i)
	{
		float3 L; 
		float ShadowDistance;
		float3 Li = EvaluateSurfelLight(SurfelLights[i], TranslatedPos, L, ShadowDistance);
		float NdotL = saturate(dot(Normal, L));

		if (NdotL > 0 && any(Li > 0) && IsLightVisible(TranslatedPos, Normal, L, ShadowDistance))
		{
			Irradiance += Li * NdotL;
		}
	}
	return Irradiance;
}

float3 SampleRadianceAt(float3 WorldPosition, float3 HitNormal)
{
	// Step 1: Direct light (how much light reaches this surface)
	float3 PreViewTranslation = DFHackToFloat(PrimaryView.PreViewTranslation);
	float3 TranslatedPosition = WorldPosition + PreViewTranslation;
	float3 DirectIrradiance = ComputeDirectLight(TranslatedPosition, HitNormal);
	
	// Step 2: Get radiance from the surfels around
	// Get surfels from grid
	int3 PixelCell = int3(floor((WorldPosition - GridPosition) / CellSize));
	if (any(PixelCell < 0.) || any(PixelCell >= (float)CellResolution))
	{
		// If outside the grid (no surfel around) return the direct light at that point
		return DirectIrradiance;
	}
	
	// Get grid cells
	uint CellIndex = (uint)PixelCell.x
			+ (uint)PixelCell.y * CellResolution
			+ (uint)PixelCell.z * CellResolution * CellResolution;
	uint Count = min(GridCounter[CellIndex], CellCapacity);

	float3 IrradianceSum = 0;
	float3 AlbedoSum = 0;
	float WeightSum = 0;
	
	// Go over the surfels and add their stored irradiance
	for (uint i = 0; i < Count; ++i)
	{
		uint Other = GridCellEntries[CellIndex * CellCapacity + i];
		float4 SecondSurfelPositionAndRadius = SurfelPositionAndRadius[Other];
		float3 SecondSurfelNormal = SurfelNormalAndFlags[Other].xyz;

		float Distance = length(SecondSurfelPositionAndRadius.xyz - WorldPosition);
		float Weight = saturate(1.0f - Distance / max(SecondSurfelPositionAndRadius.w, 1e-4f)) * saturate(dot(SecondSurfelNormal, HitNormal));
		
		if (Weight > 0.0f)
		{
			// Add the irradiance of all nearby surfels
			IrradianceSum += SurfelIrradiance[Other].xyz * Weight;
			
			// We know the surface color by extracting it from screen space GBuffer to surfels
			AlbedoSum += SurfelAlbedo[Other] * Weight;
			
			// The average
			WeightSum += Weight;
		}
	}
	
	// Integrate the lights with Monte Carlo
	float3 IndirectIrradiance = WeightSum > 0.0f ? (IrradianceSum) / WeightSum : 0;
	float3 HitAlbedo = WeightSum > 0.0f ? (AlbedoSum) / WeightSum : 0;
	
	return HitAlbedo / PI * (IndirectIrradiance +  DirectIrradiance);
}

[numthreads(THREADS_X, THREADS_Y, THREADS_Z)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	// One thread per Surfel
	uint SurfelIdx = DispatchThreadId.x;
	if (SurfelIdx >= min(SurfelCount[0], SurfelBudget)) return;
	
	float4 PositionAndRadius = SurfelPositionAndRadius[SurfelIdx];
	float3 Normal = SurfelNormalAndFlags[SurfelIdx].xyz;
	float3 Position = PositionAndRadius.xyz;

	// Get Random Hemisphere Ray Direction
	// Random values are normalized directions
	uint3 Hash = Rand3DPCG16(int3(SurfelIdx, View.StateFrameIndex, 0));
	float Random1 = Hash.x / 65535.0f;
	float Random2 = Hash.y / 65535.0f;
	
	// Weighted by normal
	float3 Direction = SampleHemisphereCosWeighted(Normal.xyz, Random1, Random2);

	// The global SDF lives in translated world space (world + PreViewTranslation)
	// Surfels are stored in world space, so convert
	float3 PreViewTranslation = DFHackToFloat(PrimaryView.PreViewTranslation);
	float3 TranslatedPosition = Position + PreViewTranslation;

	// Offset the origin one voxel along the normal to avoid self-intersection
	const float VoxelExtent = GlobalVolumeTranslatedCenterAndExtent[0].w * GlobalVolumeTexelSize;
	float3 Origin = TranslatedPosition + Normal * VoxelExtent;

	// Ray-march SDF using Unreal Utilities
	FGlobalSDFTraceInput TraceInput = SetupGlobalSDFTraceInput(Origin, Direction, MinTraceDistance, MaxTraceDistance, StepFactor, MinStepFactor);
	FGlobalSDFTraceResult TraceResult = RayTraceGlobalDistanceField(TraceInput);
	
	float3 TotalIncomingIrradiance = float3(0.f, 0.f, 0.f);
	if (GlobalSDFTraceResultIsHit(TraceResult))
	{
		// Hit position is in translated world space
		float3 TranslatedHitPosition = Origin + Direction * TraceResult.HitTime;
		
		// the SDF normal lookup expects
		float3 HitNormal = ComputeGlobalDistanceFieldNormal(TranslatedHitPosition, TraceResult.HitClipmapIndex, -Direction);

		// The grid is in world space, so convert back before looking up surfels
		float3 WorldHitPosition = TranslatedHitPosition - PreViewTranslation;
		
		// Get radiance from this point (nearby surfel and direct lights)
		TotalIncomingIrradiance = SampleRadianceAt(WorldHitPosition, HitNormal);
	}
	else // Ray miss
	{
		// TODO: should be skylight
		TotalIncomingIrradiance += float3(1.f, 1.f, 1.f);
	}
	
	// With cosine-weighted directions, one sample of irradiance is PI times the radiance
	TotalIncomingIrradiance *= PI;
	
	float3 PreviousIrradiance = SurfelIrradiance[SurfelIdx].xyz;
	
	// Temporal Blending / Accumulation
	// Alpha is the number of samples accumulated so far (0 for a freshly spawned surfel)
	float SampleCount = min(SurfelIrradiance[SurfelIdx].w + 1.0f, MaxSamples);

	// 1.0f/SampleCount makes the result a true average of all samples until MaxSamples is reached
	// Temporal Blend = 1 means new values replaces old ones entirely
	// how much of the new sample is mixed in per frame
	float TemporalBlend = 1.0f / SampleCount;
	
	float3 NewIrradiance = lerp(PreviousIrradiance, TotalIncomingIrradiance, TemporalBlend);
	SurfelIrradiance[SurfelIdx] = float4(NewIrradiance, SampleCount);
}