#include "/Engine/Public/Platform.ush"
#include "/Engine/Private/Common.ush"
#include "/Engine/Private/ScreenPass.ush"

Texture2D InputSceneColor;
Texture2D SceneDepthTexture;

SCREEN_PASS_TEXTURE_VIEWPORT(InputViewport)

float Intensity;

// Fraction of the true surfel radius drawn, so individual surfels stay distinguishable
// even when r.Surfel.Radius is sized for spawning/coverage rather than debug display.
float DebugRadiusScale;

RWTexture2D<float4> OutRenderTarget;

RWStructuredBuffer<uint> SurfelCount;
RWStructuredBuffer<float4> SurfelPositionAndRadius;
RWStructuredBuffer<float4> SurfelNormalAndFlags;

RWStructuredBuffer<uint> GridCellEntries;
RWStructuredBuffer<uint> GridCounter;
float3 GridPosition;
uint GridCellCount;
uint CellResolution;
uint CellCapacity;
uint CellSize;

// 0 = brute-force loop over every surfel, 1 = query the grid above.
uint bUseGrid;

// Hash -> stable per-surfel debug color so each surfel is visually distinct.
float3 HashColor(uint Seed)
{
    uint H = Seed * 747796405u + 2891336453u;
    H = ((H >> ((H >> 28u) + 4u)) ^ H) * 277803737u;
    H = (H >> 22u) ^ H;

    float3 Color;
    Color.x = float((H      ) & 0xFF) / 255.0f;
    Color.y = float((H >> 8 ) & 0xFF) / 255.0f;
    Color.z = float((H >> 16) & 0xFF) / 255.0f;
    return saturate(Color * 0.7f + 0.3f);
}

// Tests one surfel against a pixel; updates Result/ClosestSceneDepth if this
// surfel covers the pixel and is nearer than whatever was already found.
// Shared by both the grid query and the brute-force fallback below.
void TestSurfel(uint SurfelIndex, uint2 PixelPos, inout float3 Result, inout float ClosestSceneDepth)
{
    float4 PositionAndRadius = SurfelPositionAndRadius[SurfelIndex];
    float3 WorldPosition = PositionAndRadius.xyz;
    float SurfelRadius = PositionAndRadius.w * DebugRadiusScale;

    // Surfels are stored in true world space; re-translate into this frame's
    // translated-world space (PrimaryView.PreViewTranslation shifts with the
    // camera every frame) before projecting, otherwise surfels appear to stick
    // to the screen instead of staying fixed in the world.
    float3 TranslatedWorldPosition = DFFastAddDemote(WorldPosition, PrimaryView.PreViewTranslation);

    // Project the surfel's world position into clip space, then screen pixels.
    float4 ClipPosition = mul(float4(TranslatedWorldPosition, 1.0f), View.TranslatedWorldToClip);

    // Behind the camera: skip.
    if (ClipPosition.w <= 0.0f)
    {
        return;
    }

    float2 ScreenUV = (ClipPosition.xy / ClipPosition.w) * float2(0.5f, -0.5f) + 0.5f;
    float2 SurfelPixelPos = ScreenUV * View.ViewSizeAndInvSize.xy + View.ViewRectMin.xy;

    // Approximate the surfel's on-screen radius by projecting a world-space
    // offset point alongside it and measuring the resulting pixel distance.
    float4 EdgeClipPosition = mul(float4(TranslatedWorldPosition + View.ViewRight * SurfelRadius, 1.0f), View.TranslatedWorldToClip);
    float PixelRadius = 1.0f;
    if (EdgeClipPosition.w > 0.0f)
    {
        float2 EdgeScreenUV = (EdgeClipPosition.xy / EdgeClipPosition.w) * float2(0.5f, -0.5f) + 0.5f;
        float2 EdgePixelPos = EdgeScreenUV * View.ViewSizeAndInvSize.xy + View.ViewRectMin.xy;
        PixelRadius = max(1.0f, length(EdgePixelPos - SurfelPixelPos));
    }

    if (length(float2(PixelPos) + 0.5f - SurfelPixelPos) <= PixelRadius)
    {
        // Keep whichever surfel is nearest the camera so overlapping surfels
        // don't just flicker to whichever index happened to run last.
        if (ClipPosition.w < ClosestSceneDepth)
        {
            ClosestSceneDepth = ClipPosition.w;
            Result = HashColor(SurfelIndex);
        }
    }
}

[numthreads(THREADS_X, THREADS_Y, THREADS_Z)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
    // We dispatch in whole groups, so the last group runs past the edge.
    // Threads outside the viewport must do nothing.
    if (any(DispatchThreadId.xy >= (uint2)InputViewport_ViewportMax))
    {
        return;
    }

    // Pixel coordinate inside the full texture (viewport may be offset in it).
    uint2 PixelPos = (uint2)InputViewport_ViewportMin + DispatchThreadId.xy;

    // UV in [0,1] across the texture, sampled at the pixel centre (+0.5).
    float2 UV = (float2(InputViewport_ViewportMin) + (float2(DispatchThreadId.xy) + 0.5f))
              * InputViewport_ExtentInverse;

    float4 SceneColor = InputSceneColor.SampleLevel(GlobalPointClampedSampler, UV, 0);

    float3 Result = SceneColor.rgb;
    float ClosestSceneDepth = 1e20f;

    bool bQueriedGrid = false;

    if (bUseGrid != 0)
    {
        // Reconstruct this pixel's true world position (same space surfels are
        // stored in) so we can find which grid cell it falls into.
        int3 LoadPos = int3(PixelPos, 0);
        float DeviceZ = SceneDepthTexture.Load(LoadPos).r;

        // Sky has no depth to reconstruct a position from - leave bQueriedGrid
        // false so this pixel falls through to the brute-force path below.
        if (DeviceZ > 0.0f)
        {
            float4 SvPosition = float4(PixelPos + 0.5f, DeviceZ, 1.0f);
            float3 TranslatedWorldPosition = SvPositionToTranslatedWorld(SvPosition);
            float3 WorldPositionPixel = DFFastSubtractDemote(TranslatedWorldPosition, PrimaryView.PreViewTranslation);

            int3 PixelCell = int3(floor((WorldPositionPixel - GridPosition) / CellSize));

            if (all(PixelCell >= 0) && all(PixelCell < (int)CellResolution))
            {
                bQueriedGrid = true;

                // Check the pixel's own cell plus its 26 neighbors: a surfel
                // centered in an adjacent cell can still overlap this pixel.
                for (int dz = -1; dz <= 1; dz++)
                for (int dy = -1; dy <= 1; dy++)
                for (int dx = -1; dx <= 1; dx++)
                {
                    int3 NeighborCell = PixelCell + int3(dx, dy, dz);
                    if (any(NeighborCell < 0) || any(NeighborCell >= (int)CellResolution))
                    {
                        continue;
                    }

                    uint CellIdx = (uint)NeighborCell.x
                        + (uint)NeighborCell.y * CellResolution
                        + (uint)NeighborCell.z * CellResolution * CellResolution;

                    // Insertion is fixed-capacity: a cell's counter can exceed
                    // CellCapacity if it overflowed, so clamp the read.
                    uint EntryCount = min(GridCounter[CellIdx], CellCapacity);
                    for (uint i = 0; i < EntryCount; i++)
                    {
                        uint SurfelIndex = GridCellEntries[CellIdx * CellCapacity + i];
                        TestSurfel(SurfelIndex, PixelPos, Result, ClosestSceneDepth);
                    }
                }
            }
        }
    }

    if (!bQueriedGrid)
    {
        // Brute-force fallback: grid disabled, sky pixel, or outside grid bounds.
        // O(NumSurfels) per pixel - correct but not meant to scale, kept around
        // to A/B against the grid path via r.Surfel.UseGrid.
        uint NumSurfels = SurfelCount[0];
        for (uint SurfelIndex = 0; SurfelIndex < NumSurfels; SurfelIndex++)
        {
            TestSurfel(SurfelIndex, PixelPos, Result, ClosestSceneDepth);
        }
    }

    OutRenderTarget[PixelPos] = float4(lerp(SceneColor.rgb, Result, saturate(Intensity)), SceneColor.a);
}
