#pragma once
// Gather writes this for pixels whose surface lies outside the grid.
#define SURFEL_COVERAGE_OUT_OF_GRID 1e20f
// Gather writes this for pixels whose grid cell has no room left, so Spawn doesn't pile more surfels into it.
// Below OUT_OF_GRID so the Coverage visualization still shows it as saturated heat instead of the out-of-grid color.
#define SURFEL_COVERAGE_CELL_FULL 1e10f

// Unreal probably has something as well for the following functions
// The following 3 functions (Basis, SphericalToCartesian, Hemisphere) are taken from: https://www.shadertoy.com/view/ldBcDt
void Basis(float3 n, out float3 f, out float3 r)
{
	if(n.z < -0.999999f) {
		f = float3(0.f , -1.f, 0.f);
		r = float3(-1.f, 0.f, 0.f);
	} else {
		float a = 1.f / (1.f + n.z);
		float b = -n.x * n.y * a;
		f = float3(1.f - n.x * n.x * a, b, -n.x);
		r = float3(b, 1.f - n.y * n.y * a , -n.y);
	}
}

float3 LocalToWorld( float3 localDir, float3 normal ) 
{
	float3 a, b;
	Basis( normal, a, b );
	return localDir.x * a + localDir.y * b + localDir.z * normal;
}

// Represent a direction from center in spherical coordinates
float3 SphericalToCartesian( float rho, float phi, float theta ) 
{
	float sinTheta = sin(theta);
	return float3(sinTheta * cos(phi), sinTheta * sin(phi), cos(theta)) * rho;
}

// If you have a Surfel normal some direction will come out of it
// I use that to bounce the scene for indirect light
float3 SampleHemisphereCosWeighted(float3 Normal, float Xi1, float Xi2 ) 
{
	float theta = acos(sqrt(1.0f - Xi1));
	float phi = 2 * PI * Xi2;
	return LocalToWorld( SphericalToCartesian( 1.0f, phi, theta ), Normal );
}

float3 SurfelIndirectRadiance(float4 IrradianceAndWeight, float3 DiffuseColor)
{
	// The edge of the surfel coverage doesn't show as a hard line while surfels are still spawning
	const float FullCoverageWeight = 0.25f;
	float CoverageFade = saturate(IrradianceAndWeight.a / FullCoverageWeight);

	// Lambert BRDF (albedo / PI) turns incoming irradiance into outgoing radiance, same as at the ray hit in SurfelIrradiance.usf
	return DiffuseColor / PI * IrradianceAndWeight.rgb * CoverageFade;
}

// Shared by Gather and Visualize so the drawn disc is the one Spawn's coverage test sees
float SurfelCoverageWeight(float3 PixelWorldPosition, float3 PixelNormal, float4 PositionAndRadius, float3 SurfelNormal)
{
	float Distance = length(PixelWorldPosition - PositionAndRadius.xyz);
	float DistanceWeight = 1.0f - smoothstep(0.0f, PositionAndRadius.w, Distance);
	float NormalsFacingFactor = saturate(dot(normalize(SurfelNormal), PixelNormal));
	return DistanceWeight * NormalsFacingFactor;
}
