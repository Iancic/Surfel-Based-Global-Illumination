// Fullscreen compute shader example - Surfel plugin
// Stage 1: write a procedural pattern over the whole viewport.

#include "/Engine/Public/Platform.ush"
#include "/Engine/Private/Common.ush"
#include "/Engine/Private/ScreenPass.ush"

// The scene color produced by the renderer up to this point.
Texture2D InputSceneColor;

// Viewport metadata (Min/Max/Extent/ExtentInverse) for the scene color texture.
SCREEN_PASS_TEXTURE_VIEWPORT(InputViewport)

// A scalar we drive from C++ so we can see data flowing CPU -> GPU.
float Intensity;

// The texture we write into. RW = read/write = a UAV.
RWTexture2D<float4> OutRenderTarget;

[numthreads(THREADS_X, THREADS_Y, THREADS_Z)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
    // We dispatch in whole groups, so the last group runs past the edge.
    // Threads outside the viewport must do nothing.
    if (any(DispatchThreadId.xy >= (uint2)InputViewport_ViewportMax))
    {
        return;
    }

    // Pixel coordinate inside the full texture (viewport may be offset in it).
    uint2 PixelPos = (uint2)InputViewport_ViewportMin + DispatchThreadId.xy;

    // UV in [0,1] across the texture, sampled at the pixel centre (+0.5).
    float2 UV = (float2(InputViewport_ViewportMin) + (float2(DispatchThreadId.xy) + 0.5f))
              * InputViewport_ExtentInverse;

    float4 SceneColor = InputSceneColor.SampleLevel(GlobalPointClampedSampler, UV, 0);

    // Normalised 0..1 position inside the viewport, for the gradient.
    float2 ViewportUV = (float2(DispatchThreadId.xy) + 0.5f)
                      / float2(InputViewport_ViewportMax - InputViewport_ViewportMin);

    // A vignette-ish radial gradient, obviously not a "real" effect - just proof
    // that every pixel is being touched by our own code.
    float Radius = length(ViewportUV - 0.5f) * 2.0f;
    float3 Tint = lerp(float3(0.0f, 0.0f, 0.0f), float3(1.0f, 0.2f, 0.1f), saturate(Radius));

    float3 Result = lerp(SceneColor.rgb, SceneColor.rgb * Tint, saturate(Intensity));

    OutRenderTarget[PixelPos] = float4(Result, SceneColor.a);
}
